option('native_llvm_path', type : 'string', value: '/usr/local/opt/llvm@15')
option('native_arch', type : 'combo', choices : ['x86_64', 'arm64'], value : 'x86_64', description : 'Mach-O architecture, independent of the Windows PE ABI')
option('native_bridge_only', type : 'boolean', value : false, description : 'Build the owned AIR compiler and standalone Metal bridge without Wine/PE frontends')
option('build_native_components', type : 'boolean', value : true, description : 'Build native AIR and Wine Unix plugin in a Windows cross build; disable for PE-only artifacts')
option('build_airconv_for_windows', type : 'boolean', value : false)
option('dxmt_debug', type : 'boolean', value : false)
option('wine_build_path', type : 'string')
option('wine_install_path', type : 'string')
option('wine_builtin_dll', type : 'boolean', value : true)
option('enable_tests', type : 'boolean', value : false)
option('enable_nvapi', type : 'boolean', value : false)
option('enable_nvngx', type : 'boolean', value : false)
option('enable_fsr', type : 'boolean', value : false, description : 'Build the owned x64 D3D12 FidelityFX upscaling, frame-generation and ray-regeneration frontends backed by MetalFX')
option('enable_d3d12', type : 'boolean', value : false)
option('d3d12_core_generation', type : 'string', value : '', description : 'Shared Core/Main identity for paired ARM64 and ARM64EC configurations')