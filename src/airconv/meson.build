airconv_src = files([
 'airconv_context.cpp',
 'air_type.cpp',
 'air_signature.cpp',
 'air_operations.cpp',
 'dxbc_binding_sm50.cpp',
 'dxbc_binding_rootsig.cpp',
 'dxbc_converter.cpp',
 'dxbc_converter_gs.cpp',
 'dxbc_converter_ts.cpp',
 'dxbc_converter_basicblock.cpp',
 'dxbc_converter_cfg.cpp',
 'dxbc_instructions.cpp',
 'dxbc_signature.cpp',
 'dxil_converter.cpp',
 'dxil_metadata.cpp',
 'dxil_signature.cpp',
 'dxil_resources.cpp',
 'dxil_operations.cpp',
 'dxil_atomic64.cpp',
 'dxil_fp64.cpp',
 'dxil_matrix.cpp',
 'dxil_rt_operations.cpp',
 'dxil_rt_callbacks.cpp',
 'dxil_rt_query.cpp',
 'dxil_raytracing.cpp',
 'dxil_pipeline.cpp',
 'dxil_pipeline_ts.cpp',
 'dxil_mesh.cpp',
 'dxil_workgraph.cpp',
 'msaa_pixel.cpp',
 'msaa_coarse.cpp',
 'msaa_vertex.cpp',
 'msaa_mesh.cpp',
 'logic_op.cpp',
 'metallib_writer.cpp',
 'nt/air_builder.cpp',
 'nt/dxbc_converter_base.cpp',
 'transforms/lower_16bit_texread.cpp',
 'transforms/simdgroup_implicit_membarrier.cpp',
])

airconv_cli_src = files(['airconv_cli.cpp'])

build_airconv_for_windows = get_option('build_airconv_for_windows')

# generated by llvm-config --libs bitwriter passes
llvm_deps = [
 '-lLLVMPasses' ,'-lLLVMTarget' ,'-lLLVMObjCARCOpts' ,
 '-lLLVMCoroutines', '-lLLVMipo', '-lLLVMInstrumentation',
 '-lLLVMVectorize', '-lLLVMLinker', '-lLLVMIRReader', 
 '-lLLVMAsmParser',
 '-lLLVMFrontendOpenMP', '-lLLVMScalarOpts', '-lLLVMInstCombine', 
 '-lLLVMAggressiveInstCombine', '-lLLVMTransformUtils', 
 '-lLLVMBitWriter', '-lLLVMAnalysis', '-lLLVMProfileData', 
 '-lLLVMSymbolize', '-lLLVMDebugInfoPDB', '-lLLVMDebugInfoMSF', 
 '-lLLVMDebugInfoDWARF', '-lLLVMObject', '-lLLVMTextAPI', '-lLLVMMCParser', 
 '-lLLVMMC', '-lLLVMDebugInfoCodeView',
 '-lLLVMBitReader', '-lLLVMCore', '-lLLVMRemarks', '-lLLVMBitstreamReader', 
 '-lLLVMBinaryFormat', '-lLLVMSupport', '-lLLVMDemangle'
]

airconv_args = [
  '-Wno-extern-c-compat',
  # LLVM
  '-fno-exceptions',
  '-funwind-tables',
  '-fno-rtti',
  '-D_FILE_OFFSET_BITS=64',
  '-D__STDC_CONSTANT_MACROS',
  '-D__STDC_FORMAT_MACROS',
  '-D__STDC_LIMIT_MACROS',
]

if clangpp.has_argument('-Wno-unnecessary-virtual-specifier')
  # LLVM
  airconv_args += ['-Wno-unnecessary-virtual-specifier']
endif

llvm_ld_flags = [
 '-L'+join_paths(meson.project_source_root(), 'toolchains/llvm/lib')
]

airconv_forward_dep = declare_dependency(
  include_directories : [ dxmt_include_path, include_directories('.') ],
)

airconv_shaders = [
  'shaders/air_msad.metal',
  'shaders/air_samplepos.metal',
  'shaders/air_tessellation.metal',
]

airconv_shaders_ir = metalir_generator.process(
  airconv_shaders,
  extra_args: ['-std=metal3.1', '--target=air64-apple-macos14.0'],
)
airconv_shaders_header = hexdump_generator.process(airconv_shaders_ir)

# The fp32 denorm-preserve helpers rely on every step being IEEE exact.
airconv_denorm_ir = metalir_generator.process(
  'shaders/air_denorm.metal',
  extra_args: ['-std=metal3.1', '--target=air64-apple-macos14.0', '-fno-fast-math'],
)
airconv_denorm_header = hexdump_generator.process(airconv_denorm_ir)

# Integer-only binary64 helpers: C++ accepts SoftFloat's exact control flow; AIR has no f64 ALU.
airconv_fp64_ir = metalir_generator.process(
  'shaders/air_fp64.cpp',
  extra_args: ['-std=c++14', '-O3', '--target=air64-apple-macos14.0', '-fno-fast-math'],
)
airconv_fp64_header = hexdump_generator.process(airconv_fp64_ir)

# The immutable-cell protocol requires the formally specified SC32 total order.
# It is linked only by SM50_SHADER_D3D12_ATOMIC64_PHASE, never normal/D3D11 shaders.
airconv_atomic64_ir = metalir_generator.process(
  'shaders/air_atomic64.metal',
  extra_args: ['-std=metal4.1', '--target=air64-apple-macos27.0', '-fno-fast-math'],
)
airconv_atomic64_header = hexdump_generator.process(airconv_atomic64_ir)

# Sampler feedback LOD selection must match the CPU-side D3D12 footprint math exactly.
airconv_sampler_feedback_ir = metalir_generator.process(
  'shaders/air_sampler_feedback.metal',
  extra_args: ['-std=metal3.1', '--target=air64-apple-macos14.0', '-fno-fast-math'],
)
airconv_sampler_feedback_header = hexdump_generator.process(airconv_sampler_feedback_ir)

# Conservative rasterization: the snapped polygon must match msaa_gather_conservative_depth bit for bit
# (src/airconv/shaders/conservative_polygon.h is shared with src/dxmt/dxmt_command.metal).
airconv_conservative_ir = metalir_generator.process(
  'shaders/air_conservative.metal',
  extra_args: ['-std=metal3.1', '--target=air64-apple-macos14.0', '-fno-fast-math'],
)
airconv_conservative_header = hexdump_generator.process(airconv_conservative_ir)

# D3D12 work graph node kernel run-time helpers (dxil_workgraph.cpp).
airconv_workgraph_ir = metalir_generator.process(
  'shaders/air_workgraph.metal',
  extra_args: ['-std=metal3.1', '--target=air64-apple-macos14.0'],
)
airconv_workgraph_header = hexdump_generator.process(airconv_workgraph_ir)

airconv_src += [airconv_shaders_header, airconv_denorm_header, airconv_fp64_header, airconv_sampler_feedback_header,
                airconv_conservative_header, airconv_workgraph_header, airconv_atomic64_header]

if build_airconv_for_windows

llvm_include_path = include_directories('../../toolchains/llvm/include') # FIXME: in favor of path relative to project

airconv_lib = static_library('airconv', airconv_src,
  include_directories : [ dxmt_include_path, llvm_include_path ],
  cpp_args            : [ airconv_args, '-DWIN_EXPORT' ],
  dependencies        : [ dxbc_parser_dep ],
  link_args           : llvm_ld_flags
)

airconv_dep = declare_dependency(
  link_with           : [ airconv_lib ],
  include_directories : [ dxmt_include_path, include_directories('.') ],
  dependencies        : [ dxbc_parser_dep ],
  link_args           : [ llvm_ld_flags, llvm_deps ] # meh
)

lib_d3dcompiler = cpp.find_library('d3dcompiler_47')

executable('airconv', airconv_src + airconv_cli_src,
  include_directories : [ dxmt_include_path, llvm_include_path ],
  cpp_args            : [ airconv_args, '-DWIN_EXPORT' ],
  dependencies        : [ dxbc_parser_dep, lib_d3dcompiler ],
  link_args           : [ llvm_ld_flags, llvm_deps ]
)

endif

if build_native_components and (cpu_family == 'x86_64' or cpu_family == 'aarch64' or not dxmt_crossbuild)
  subdir('darwin')
endif