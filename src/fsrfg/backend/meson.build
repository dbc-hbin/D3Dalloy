# MIT pinned ordinary-DXIL interpolation; no external/native vendor renderer.
phase_dxil = files(
  'shaders/fi0_p0.dxil',
  'shaders/fi0_p1.dxil',
  'shaders/fi0_p2.dxil',
  'shaders/fi0_p3.dxil',
  'shaders/fi0_p4.dxil',
  'shaders/fi0_p5.dxil',
  'shaders/fi0_p6.dxil',
  'shaders/fi0_p7.dxil',
  'shaders/fi1_p0.dxil',
  'shaders/fi2_p0.dxil',
  'shaders/fi2_p4.dxil',
  'shaders/fi3_p0.dxil',
  'shaders/fi4_p0.dxil',
  'shaders/fi5_p0.dxil',
  'shaders/fi5_p4.dxil',
  'shaders/fi6_p0.dxil',
  'shaders/fi7_p0.dxil',
  'shaders/fi8_p0.dxil',
  'shaders/fi9_p0.dxil',
  'shaders/fi10_p0.dxil',
  'shaders/bi0_p0.dxil',
  'shaders/bi1_p0.dxil',
  'shaders/bi2_p0.dxil',
  'shaders/bi3_p0.dxil',
  'shaders/bi3_p4.dxil',
  'shaders/of0_p0.dxil',
  'shaders/of1_p0.dxil',
  'shaders/of2_p0.dxil',
  'shaders/of3_p0.dxil',
  'shaders/of4_p0.dxil',
  'shaders/of5_p0.dxil',
  'shaders/of6_p0.dxil',
  'shaders/of0_p1.dxil',
  'shaders/of1_p1.dxil',
  'shaders/of2_p1.dxil',
  'shaders/of3_p1.dxil',
  'shaders/of4_p1.dxil',
  'shaders/of5_p1.dxil',
  'shaders/of6_p1.dxil',
  'shaders/owned_publish_dxil.dxil',
)
phase_headers = hexdump_generator.process(phase_dxil)
phase_backend_inc = include_directories('.', 'api/include', 'api/internal')
phase_backend = static_library('owned-phase-backend',
  'backend/dx12/ffx_dx12.cpp',
  'api/internal/ffx_assert.cpp',
  'api/internal/ffx_message.cpp',
  'api/internal/ffx_object_management.cpp',
  'framegeneration/fsr3/internal/ffx_frameinterpolation.cpp',
  'framegeneration/fsr3/internal/ffx_opticalflow.cpp',
  'shaders/shaderblobs.cpp', phase_headers,
  include_directories: phase_backend_inc,
  cpp_args: ['-D_WINDOWS'],
  install: false,
)
phase_backend_dep = declare_dependency(link_with: phase_backend,
  include_directories: phase_backend_inc, compile_args: ['-D_WINDOWS'],
  sources: phase_headers)
