diff --git a/dlls/wow64win/user.c b/dlls/wow64win/user.c
--- a/dlls/wow64win/user.c
+++ b/dlls/wow64win/user.c
@@ -3400,9 +3400,19 @@
 NTSTATUS WINAPI wow64_NtUserInitializeClientPfnArrays( UINT *args )
 {
     const ntuser_client_func_ptr *procsA = get_ptr( &args );
     const ntuser_client_func_ptr *procsW = get_ptr( &args );
     const ntuser_client_func_ptr *workers = get_ptr( &args );
     HINSTANCE user_module = get_ptr( &args );
+    ULONG_PTR guest_base;
+    NTSTATUS status;
+
+    status = NtQueryInformationProcess( GetCurrentProcess(), ProcessWineWow64GuestBase,
+                                       &guest_base, sizeof(guest_base), NULL );
+    if (status) return status;
+    /* The arrays are CPU memory; their callback entries and module identity are not. */
+    if (procsA) procsA = (const ntuser_client_func_ptr *)(guest_base + (ULONG_PTR)procsA);
+    if (procsW) procsW = (const ntuser_client_func_ptr *)(guest_base + (ULONG_PTR)procsW);
+    if (workers) workers = (const ntuser_client_func_ptr *)(guest_base + (ULONG_PTR)workers);
 
     return NtUserInitializeClientPfnArrays( procsA, procsW, workers, user_module );
 }
diff --git a/dlls/ntdll/locale.c b/dlls/ntdll/locale.c
--- a/dlls/ntdll/locale.c
+++ b/dlls/ntdll/locale.c
@@ -110,3 +110,5 @@
     const struct locale_nls_header *header;
     PEB64 *peb64 = get_peb64();
+    /* The native PEB retains its full address; the PE32 view truncates it. */
+    ULONGLONG guest_base = peb64 ? NtCurrentTeb64()->Peb - PtrToUlong( peb64 ) : 0;
 
@@ -165,20 +167,20 @@
     NtGetNlsSectionPtr( 10, 0, NULL, &case_ptr, &size );
     NtCurrentTeb()->Peb->UnicodeCaseTableData = case_ptr;
-    if (peb64) peb64->UnicodeCaseTableData = PtrToUlong( case_ptr );
+    if (peb64) peb64->UnicodeCaseTableData = guest_base + PtrToUlong( case_ptr );
     if (ansi_cp != CP_UTF8)
     {
         NtGetNlsSectionPtr( 11, ansi_cp, NULL, &ansi_ptr, &size );
         NtCurrentTeb()->Peb->AnsiCodePageData = ansi_ptr;
-        if (peb64) peb64->AnsiCodePageData = PtrToUlong( ansi_ptr );
+        if (peb64) peb64->AnsiCodePageData = guest_base + PtrToUlong( ansi_ptr );
     }
     if (oem_cp != CP_UTF8)
     {
         NtGetNlsSectionPtr( 11, oem_cp, NULL, &oem_ptr, &size );
         NtCurrentTeb()->Peb->OemCodePageData = oem_ptr;
-        if (peb64) peb64->OemCodePageData = PtrToUlong( oem_ptr );
+        if (peb64) peb64->OemCodePageData = guest_base + PtrToUlong( oem_ptr );
     }
     RtlInitNlsTables( ansi_ptr, oem_ptr, case_ptr, &nls_info );
     NlsAnsiCodePage     = nls_info.AnsiTableInfo.CodePage;
     NlsMbCodePageTag    = nls_info.AnsiTableInfo.DBCSCodePage;
     NlsMbOemCodePageTag = nls_info.OemTableInfo.DBCSCodePage;
 }
diff --git a/dlls/opengl32/unix_private.h b/dlls/opengl32/unix_private.h
--- a/dlls/opengl32/unix_private.h
+++ b/dlls/opengl32/unix_private.h
@@ -78,5 +78,9 @@
 static inline TEB *get_teb64( ULONG teb32 )
 {
     TEB32 *teb32_ptr = ULongToPtr( teb32 );
+#if defined(__APPLE__) && defined(__aarch64__)
+    /* Native TEBs share the process guest window, aligned to 4GB. */
+    teb32_ptr = (TEB32 *)(((ULONG_PTR)NtCurrentTeb() & ~0xffffffffUL) + teb32);
+#endif
     return (TEB *)((char *)teb32_ptr + teb32_ptr->WowTebOffset);
 }
