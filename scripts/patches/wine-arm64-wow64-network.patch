+/* WoW64 Unix thunks receive host argument blocks containing guest pointers. */
+static inline ULONG_PTR wine_unix_wow64_guest_base(void)
+{
+    ULONG_PTR base = 0;
+#if defined(__APPLE__) && defined(__aarch64__) && defined(_WIN64)
+    NtQueryInformationProcess( NtCurrentProcess(), ProcessWineWow64GuestBase,
+                               &base, sizeof(base), NULL );
+#endif
+    return base;
+}
+
+static inline void *wine_unix_ptr32( ULONG addr )
+{
+    return addr ? (void *)(wine_unix_wow64_guest_base() + addr) : NULL;
+}
+
+static inline ULONG wine_unix_ptr_to32( const void *ptr )
+{
+    return ptr ? (ULONG)((ULONG_PTR)ptr - wine_unix_wow64_guest_base()) : 0;
+}
