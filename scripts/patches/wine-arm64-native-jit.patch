 /***********************************************************************
+ *           __wine_jit_write_protect
+ *
+ * Return the previous mode for explicit, nestable native JIT write scopes.
+ * Enable=2 queries availability/current mode; unsupported hosts return -1.
+ */
+BOOL WINAPI __wine_jit_write_protect( BOOL enable )
+{
+    struct jit_write_protect_params params = { enable, -1 };
+
+    if (WINE_UNIX_CALL( unix_jit_write_protect, &params )) return -1;
+    return params.previous;
+}
+
