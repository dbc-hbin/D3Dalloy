+static NTSTATUS unixcall_jit_write_protect( void *args )
+{
+#if defined(__APPLE__) && defined(__aarch64__)
+    static __thread BOOL enabled = TRUE;
+    struct jit_write_protect_params *params = args;
+
+    params->previous = enabled;
+    if (params->enable == 2) return STATUS_SUCCESS;
+    pthread_jit_write_protect_np( !!params->enable );
+    enabled = !!params->enable;
+    return STATUS_SUCCESS;
+#else
+    return STATUS_NOT_SUPPORTED;
+#endif
+}
