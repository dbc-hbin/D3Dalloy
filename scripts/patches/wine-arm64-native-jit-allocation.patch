--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -2226,5 +2226,35 @@
 #endif
 
 
+NTSTATUS unixcall_allocate_native_jit( void *args )
+{
+#if defined(__APPLE__) && defined(__aarch64__)
+    struct allocate_native_jit_params *params = args;
+    struct file_view *view;
+    sigset_t sigset;
+    SIZE_T size;
+    NTSTATUS status;
+
+    /* This private API creates committed native JIT buffers only. It does
+     * not label them ARM64EC or permit fixed-address reservation/recommit. */
+    if (params->base || !params->size || params->size > ~(SIZE_T)0 - host_page_mask)
+        return STATUS_INVALID_PARAMETER;
+    size = ROUND_SIZE( 0, params->size, host_page_mask );
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    status = map_native_jit_view( &view, NULL, size,
+                                 VPROT_NATIVE_JIT | VPROT_COMMITTED | VPROT_READ | VPROT_WRITE | VPROT_EXEC,
+                                 0, 0, granularity_mask );
+    if (!status)
+    {
+        params->base = (ULONG_PTR)view->base;
+        params->size = size;
+    }
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+    return status;
+#else
+    return STATUS_NOT_SUPPORTED;
+#endif
+}
+
