diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -3422,3 +3422,19 @@
 /***********************************************************************
+ *           __wine_allocate_native_jit
+ */
+NTSTATUS WINAPI __wine_allocate_native_jit( void **base, SIZE_T *size )
+{
+    struct allocate_native_jit_params params = { (ULONG_PTR)*base, *size };
+    NTSTATUS status = WINE_UNIX_CALL( unix_allocate_native_jit, &params );
+
+    if (!status)
+    {
+        *base = (void *)(ULONG_PTR)params.base;
+        *size = params.size;
+    }
+    return status;
+}
