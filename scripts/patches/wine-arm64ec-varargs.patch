--- a/tools/winebuild/spec32.c
+++ b/tools/winebuild/spec32.c
@@ -867,6 +867,56 @@
     needs_get_pc_thunk = 0;
     open_output_file();
     output_standard_file_header();
+    if (is_pe() && target.cpu == CPU_ARM64EC)
+    {
+        /* LLVM 22 does not copy variadic stack arguments in integer exit thunks.
+         * The spec object is linked first, so its COMDAT replaces that thunk.
+         * Keep a frame pointer for unwind and probe each newly allocated page. */
+        output( ".section .text$varargs,\"xr\",discard,\"$iexit_thunk$cdecl$i8$varargs\"\n"
+                ".p2align 2\n"
+                ".globl \"$iexit_thunk$cdecl$i8$varargs\"\n"
+                ".seh_proc \"$iexit_thunk$cdecl$i8$varargs\"\n"
+                "\"$iexit_thunk$cdecl$i8$varargs\":\n\t"
+                "stp x29, x30, [sp, #-16]!\n\t"
+                ".seh_save_fplr_x 16\n\t"
+                "mov x29, sp\n\t"
+                ".seh_set_fp\n\t"
+                ".seh_endprologue\n\t"
+                "add x8, x5, #47\n\t"
+                "and x8, x8, #-16\n\t"
+                "mov x10, sp\n"
+                "1:\n\t"
+                "cmp x8, #4096\n\t"
+                "b.lo 2f\n\t"
+                "sub x10, x10, #4096\n\t"
+                "str xzr, [x10]\n\t"
+                "sub x8, x8, #4096\n\t"
+                "b 1b\n"
+                "2:\n\t"
+                "sub x10, x10, x8\n\t"
+                "str xzr, [x10]\n\t"
+                "mov sp, x10\n\t"
+                "add x11, sp, #32\n\t"
+                "cbz x5, 4f\n"
+                "3:\n\t"
+                "ldr x12, [x4], #8\n\t"
+                "str x12, [x11], #8\n\t"
+                "subs x5, x5, #8\n\t"
+                "b.ne 3b\n"
+                "4:\n\t"
+                "adrp x16, __os_arm64x_dispatch_call_no_redirect\n\t"
+                "ldr x16, [x16, #:lo12:__os_arm64x_dispatch_call_no_redirect]\n\t"
+                "blr x16\n\t"
+                "mov x0, x8\n\t"
+                ".seh_startepilogue\n\t"
+                "mov sp, x29\n\t"
+                ".seh_set_fp\n\t"
+                "ldp x29, x30, [sp], #16\n\t"
+                ".seh_save_fplr_x 16\n\t"
+                ".seh_endepilogue\n\t"
+                "ret\n\t"
+                ".seh_endproc\n" );
+    }
     output_module( spec );
     output_stubs( spec );
     output_exports( spec );
