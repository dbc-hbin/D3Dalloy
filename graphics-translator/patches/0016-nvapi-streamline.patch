 NVAPI_INTERFACE
+NvAPI_GetLogicalGPUFromPhysicalGPU(__in NvPhysicalGpuHandle hPhysicalGPU,
+                                   __out NvLogicalGpuHandle *pLogicalGPU) {
+  if (!pLogicalGPU)
+    return NVAPI_INVALID_ARGUMENT;
+  *pLogicalGPU = nullptr;
+
+  if (!hPhysicalGPU)
+    return NVAPI_INVALID_ARGUMENT;
+
+  auto devices = WMT::CopyAllDevices();
+  if (!FindMetalDeviceByGpuHandle(devices, uint64_t(hPhysicalGPU)))
+    return NVAPI_INVALID_ARGUMENT;
+
+  /*
+   * Every Metal device is a standalone physical GPU exposing exactly one
+   * logical GPU, so the logical handle is the same stable identifier.
+   */
+  *pLogicalGPU = (NvLogicalGpuHandle)uint64_t(hPhysicalGPU);
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_GetPhysicalGPUsFromLogicalGPU(__in NvLogicalGpuHandle hLogicalGPU,
+                                    __out NvPhysicalGpuHandle nvGPUHandle[NVAPI_MAX_PHYSICAL_GPUS],
+                                    __out NvU32 *pGpuCount) {
+  if (!nvGPUHandle || !pGpuCount)
+    return NVAPI_INVALID_ARGUMENT;
+  *pGpuCount = 0;
+
+  if (!hLogicalGPU)
+    return NVAPI_INVALID_ARGUMENT;
+
+  auto devices = WMT::CopyAllDevices();
+  if (!FindMetalDeviceByGpuHandle(devices, uint64_t(hLogicalGPU)))
+    return NVAPI_INVALID_ARGUMENT;
+
+  nvGPUHandle[0] = (NvPhysicalGpuHandle)uint64_t(hLogicalGPU);
+  *pGpuCount = 1;
+  return NVAPI_OK;
+}
