+NVAPI_INTERFACE NvAPI_D3D12_IsNvShaderExtnOpCodeSupported(
+    __in ID3D12Device *pDevice, __in NvU32 opCode, __out bool *pSupported) {
+  if (!pDevice || !pSupported)
+    return NVAPI_INVALID_ARGUMENT;
+
+  /*
+   * Neither the DXBC nor the DXIL->AIR shader translator implements any of the
+   * vendor shader extension intrinsics, so no opcode may be advertised as
+   * supported. Reporting FALSE is the documented way to make the application
+   * fall back to standard HLSL, whereas claiming support would produce shaders
+   * the translator cannot compile.
+   */
+  WARN("nvapi: unsupported shader extension opcode ", opCode);
+  *pSupported = false;
+  return NVAPI_OK;
+}
