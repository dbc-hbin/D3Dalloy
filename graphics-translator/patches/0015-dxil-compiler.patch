+/* Every acceleration-structure entry point transports its arguments as 64-bit words, so one
+ * shared block covers all of them. */
+static struct unixcall_wmt_as *
+WMTASPack(struct unixcall_wmt_as *params, const uint64_t *args, unsigned count) {
+  memset(params, 0, sizeof(*params));
+  memcpy(params->args, args, count * sizeof(uint64_t));
+  return params;
+}
