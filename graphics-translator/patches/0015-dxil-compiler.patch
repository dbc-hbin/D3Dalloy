+/* Export enumeration                                                         */
+/* -------------------------------------------------------------------------- */
+
+namespace {
+
+
+
+/** Hand an llvm::Error to the caller, or release it when no slot was offered. */
+void reportError(llvm::Error failure, sm50_error_t *ppError) {
+  auto *error = new dxmt::dxil::SM50ErrorInternal();
+  llvm::raw_svector_ostream stream(error->buf);
+  llvm::handleAllErrors(
+    std::move(failure), [&](const llvm::ErrorInfoBase &base) { base.log(stream); }
+  );
+  stream << '\0';
+  if (ppError)
+    *ppError = (sm50_error_t)error;
+  else
+    delete error;
+}
+
+void reportMessage(const llvm::Twine &message, sm50_error_t *ppError) {
+  auto *error = new dxmt::dxil::SM50ErrorInternal();
+  llvm::raw_svector_ostream stream(error->buf);
+  stream << message << '\0';
+  if (ppError)
+    *ppError = (sm50_error_t)error;
+  else
+    delete error;
+}
+
+} // namespace
+
+AIRCONV_API int SM50RTEnumerateLibraryExports(
+  const void *pBytecode, uint64_t BytecodeSize, struct sm50_rt_library_export_info *pExports,
+  uint32_t ExportCapacity, char *pNames, uint64_t NamesSize, uint32_t *pExportCount,
+  uint64_t *pNamesSize, sm50_error_t *ppError
+) {
+  using namespace dxmt;
+
+  if (ppError)
+    *ppError = nullptr;
+  if (!pBytecode || !BytecodeSize || !pExportCount || !pNamesSize) {
+    reportMessage(
+      "SM50RTEnumerateLibraryExports requires bytecode and both count outputs", ppError
+    );
+    return 0;
+  }
+
+  std::vector<dxil::LibraryExport> exports;
+  if (auto failure = dxil::enumerateExports(pBytecode, BytecodeSize, exports)) {
+    reportError(std::move(failure), ppError);
+    return 0;
+  }
+
+  uint64_t names_size = 0;
+  for (const auto &entry : exports)
+    /* Both names of an export, each NUL terminated. */
+    names_size += entry.name.size() + 1 + entry.entry_point.size() + 1;
+
+  const bool query_only = !pExports || !pNames;
+  if (query_only || ExportCapacity < exports.size() || NamesSize < names_size) {
+    /* Two-call protocol: always report the required sizes, and only fail when the
+     * caller offered buffers that are too small. */
+    *pExportCount = static_cast<uint32_t>(exports.size());
+    *pNamesSize = names_size;
+    if (query_only)
+      return 1;
+    reportMessage(
+      "SM50RTEnumerateLibraryExports buffers are too small for the library exports", ppError
+    );
+    return 0;
+  }
+
+  uint64_t offset = 0;
+  auto write_name = [&](const std::string &value) {
+    const uint32_t name_offset = static_cast<uint32_t>(offset);
+    std::memcpy(pNames + offset, value.c_str(), value.size() + 1);
+    offset += value.size() + 1;
+    return name_offset;
+  };
+  for (size_t i = 0; i < exports.size(); ++i) {
+    auto &info = pExports[i];
+    info.stage = exports[i].stage;
+    info.name_offset = write_name(exports[i].name);
+    info.name_length = static_cast<uint32_t>(exports[i].name.size());
+    info.entry_point_offset = write_name(exports[i].entry_point);
+    info.entry_point_length = static_cast<uint32_t>(exports[i].entry_point.size());
+  }
+  *pExportCount = static_cast<uint32_t>(exports.size());
+  *pNamesSize = names_size;
+  return 1;
+}
+
+/* -------------------------------------------------------------------------- */
+/* Ray generation dispatcher for multi-raygen pipelines                       */
+/* -------------------------------------------------------------------------- */
+
+static llvm::Error EmitRayGenerationDispatch(
+  Module &module, const std::vector<uint32_t> &raygen_indices,
+  const std::vector<std::string> &names, StringRef name
+) {
+  LLVMContext &ctx = module.getContext();
+  NamedMDNode *kernels = module.getNamedMetadata("air.kernel");
+  if (!kernels || names.empty() || names.size() != raygen_indices.size())
+    return dxmt::dxil::createError("dxil: missing raygen dispatcher entries");
+
+  SmallVector<Function *, 4> targets;
+  SmallVector<MDNode *, 4> entries;
+  std::vector<std::vector<unsigned>> mappings;
+  SmallVector<Type *, 8> types;
+  SmallVector<MDNode *, 8> inputs;
+  std::map<std::string, unsigned> slots;
+  unsigned dispatch_index = ~0u;
+  for (const auto &target_name : names) {
+    Function *target = module.getFunction(target_name);
+    MDNode *entry = nullptr;
+    for (MDNode *candidate : kernels->operands()) {
+      auto *value = dyn_cast<ValueAsMetadata>(candidate->getOperand(0));
+      if (value && value->getValue() == target)
+        entry = candidate;
+    }
+    if (!target || !entry || entry->getNumOperands() < 3)
+      return dxmt::dxil::createError("dxil: missing raygen function metadata: " + target_name);
+    auto *arguments = dyn_cast<MDNode>(entry->getOperand(2));
+    if (!arguments || arguments->getNumOperands() != target->arg_size())
+      return dxmt::dxil::createError("dxil: inconsistent raygen argument metadata");
+    targets.push_back(target);
+    entries.push_back(entry);
+    mappings.emplace_back(target->arg_size(), ~0u);
+    for (const MDOperand &operand : arguments->operands()) {
+      auto *input = cast<MDNode>(operand.get());
+      unsigned argument = mdconst::extract<ConstantInt>(input->getOperand(0))->getZExtValue();
+      if (argument >= target->arg_size())
+        return dxmt::dxil::createError("dxil: raygen argument index is out of range");
+      StringRef kind = cast<MDString>(input->getOperand(1))->getString();
+      uint64_t location = ~0ull;
+      uint64_t size = 0;
+      for (unsigned i = 2; i + 1 < input->getNumOperands(); ++i) {
+        auto *key = dyn_cast<MDString>(input->getOperand(i));
+        if (!key)
+          continue;
+        if (key->getString() == "air.location_index")
+          location = mdconst::extract<ConstantInt>(input->getOperand(i + 1))->getZExtValue();
+        if (key->getString() == "air.buffer_size")
+          size = mdconst::extract<ConstantInt>(input->getOperand(i + 1))->getZExtValue();
+      }
+      const bool buffer = kind == "air.buffer" || kind == "air.indirect_buffer";
+      std::string key = (buffer ? "buffer" : kind.str()) + ":" + std::to_string(location);
+      auto [slot, inserted] = slots.emplace(key, types.size());
+      unsigned index = slot->second;
+      Type *type = target->getArg(argument)->getType();
+      if (inserted) {
+        types.push_back(type);
+        SmallVector<Metadata *, 16> fields;
+        for (const MDOperand &field : input->operands())
+          fields.push_back(field.get());
+        fields[0] = ConstantAsMetadata::get(ConstantInt::get(Type::getInt32Ty(ctx), index));
+        inputs.push_back(MDNode::get(ctx, fields));
+      } else if (types[index] != type) {
+        auto *old_pointer = dyn_cast<PointerType>(types[index]);
+        auto *new_pointer = dyn_cast<PointerType>(type);
+        if (!buffer || !old_pointer || !new_pointer ||
+            old_pointer->getAddressSpace() != new_pointer->getAddressSpace())
+          return dxmt::dxil::createError("dxil: incompatible raygen binding types");
+        // Different local-root layouts share one byte-addressed buffer binding.
+        // Each selected body casts it back to its own validated root-signature layout.
+        for (unsigned i = 2; i + 1 < inputs[index]->getNumOperands(); ++i) {
+          auto *field = dyn_cast<MDString>(inputs[index]->getOperand(i));
+          if (field && field->getString() == "air.buffer_size")
+            size = std::max(size, mdconst::extract<ConstantInt>(inputs[index]->getOperand(i + 1))->getZExtValue());
+        }
+        types[index] = Type::getInt8PtrTy(ctx, old_pointer->getAddressSpace());
+        auto word = [&](uint64_t value) -> Metadata * {
+          return ConstantAsMetadata::get(ConstantInt::get(Type::getInt32Ty(ctx), value));
+        };
+        inputs[index] = MDNode::get(ctx, {word(index), MDString::get(ctx, "air.buffer"),
+          MDString::get(ctx, "air.buffer_size"), word(size), MDString::get(ctx, "air.location_index"),
+          word(location), word(1), MDString::get(ctx, "air.read"), MDString::get(ctx, "air.address_space"),
+          word(old_pointer->getAddressSpace()), MDString::get(ctx, "air.arg_type_name"),
+          MDString::get(ctx, "uchar"), MDString::get(ctx, "air.arg_name"), MDString::get(ctx, "root_union")});
+      }
+      mappings.back()[argument] = index;
+      if (buffer && location == SM50_RT_BINDING_INDEX_DISPATCH)
+        dispatch_index = index;
+    }
+  }
+  if (dispatch_index == ~0u)
+    return dxmt::dxil::createError("dxil: raygen dispatcher has no dispatch binding");
+  Function *dispatcher = Function::Create(FunctionType::get(Type::getVoidTy(ctx), types, false),
+    GlobalValue::ExternalLinkage, name, module);
+  IRBuilder<> b(BasicBlock::Create(ctx, "entry", dispatcher));
+  Value *dispatch = dispatcher->getArg(dispatch_index);
+  unsigned space = cast<PointerType>(dispatch->getType())->getAddressSpace();
+  Value *bytes = b.CreateBitCast(dispatch, Type::getInt8PtrTy(ctx, space));
+  Value *field = b.CreateGEP(b.getInt8Ty(), bytes,
+    b.getInt32(offsetof(SM50_RT_DISPATCH_ARGUMENTS, RayGenerationIndexBase)));
+  Value *address = b.CreateAlignedLoad(b.getInt64Ty(),
+    b.CreateBitCast(field, Type::getInt64PtrTy(ctx, space)), Align(1));
+  BasicBlock *done = BasicBlock::Create(ctx, "done", dispatcher);
+  IRBuilder<>(done).CreateRetVoid();
+  BasicBlock *lookup = BasicBlock::Create(ctx, "lookup", dispatcher);
+  b.CreateCondBr(b.CreateICmpNE(address, b.getInt64(0)), lookup, done);
+  b.SetInsertPoint(lookup);
+  Value *record = b.CreateAlignedLoad(b.getInt32Ty(),
+    b.CreateIntToPtr(address, Type::getInt32PtrTy(ctx, 1)), Align(4));
+  SwitchInst *select = b.CreateSwitch(record, done, targets.size());
+  for (unsigned i = 0; i < targets.size(); ++i) {
+    Function *target = targets[i];
+    BasicBlock *invoke = BasicBlock::Create(ctx, "raygen_" + std::to_string(raygen_indices[i]), dispatcher);
+    IRBuilder<> call(invoke);
+    SmallVector<Value *, 8> arguments;
+    for (Argument &argument : target->args()) {
+      Value *value = dispatcher->getArg(mappings[i][argument.getArgNo()]);
+      if (value->getType() != argument.getType())
+        value = call.CreateBitCast(value, argument.getType());
+      arguments.push_back(value);
+    }
+    call.CreateCall(target, arguments);
+    call.CreateBr(done);
+    select->addCase(b.getInt32(raygen_indices[i]), invoke);
+    target->setLinkage(GlobalValue::InternalLinkage);
+    target->addFnAttr(Attribute::AlwaysInline);
+  }
+  SmallVector<Metadata *, 8> dispatcher_fields;
+  for (const MDOperand &operand : entries.front()->operands())
+    dispatcher_fields.push_back(operand.get());
+  dispatcher_fields[0] = ValueAsMetadata::get(dispatcher);
+  dispatcher_fields[2] = MDNode::get(ctx, SmallVector<Metadata *, 8>(inputs.begin(), inputs.end()));
+  MDNode *metadata = MDNode::get(ctx, dispatcher_fields);
+  SmallVector<MDNode *, 4> kept;
+  for (MDNode *entry : kernels->operands())
+    if (std::find(entries.begin(), entries.end(), entry) == entries.end())
+      kept.push_back(entry);
+  kernels->clearOperands();
+  for (MDNode *entry : kept)
+    kernels->addOperand(entry);
+  kernels->addOperand(metadata);
+  return Error::success();
+}
+
+/* -------------------------------------------------------------------------- */
+/* Pipeline compilation                                                       */
+/* -------------------------------------------------------------------------- */
+
+AIRCONV_API int SM50CompileRaytracingPipeline(
+  const struct SM50_RT_PIPELINE_DESC *pDesc, sm50_bitcode_t *ppBitcode,
+  struct SM50_COMPILED_BITCODE *pMetallib, struct SM50_RT_FUNCTION_INFO *pFunctions,
+  uint32_t FunctionCapacity, uint32_t *pFunctionCount, sm50_error_t *ppError
+) {
+  using namespace dxmt;
+
+
+
+  if (ppError)
+    *ppError = nullptr;
+  if (!pDesc || !ppBitcode || !pMetallib || !pFunctionCount) {
+    reportMessage("SM50CompileRaytracingPipeline requires a description and outputs", ppError);
+    return 0;
+  }
+  if (!pDesc->Exports || !pDesc->ExportCount || !pDesc->Libraries || !pDesc->LibraryCount) {
+    reportMessage("the raytracing pipeline description has no libraries or exports", ppError);
+    return 0;
+  }
+  /*
+   * Reflection includes exports, triangle and optional bounding-box callbacks,
+   * and an optional synthesized multi-raygen dispatcher.
+   */
+  uint32_t raygen_count = 0;
+  uint32_t procedural_continuation_count = 0;
+  bool has_intersection = false;
+  for (uint32_t i = 0; i < pDesc->ExportCount; ++i) {
+    raygen_count += pDesc->Exports[i].Stage == SM50_RT_STAGE_RAYGEN;
+    has_intersection |= pDesc->Exports[i].Stage == SM50_RT_STAGE_INTERSECTION;
+    procedural_continuation_count += pDesc->Exports[i].Stage == SM50_RT_STAGE_INTERSECTION &&
+      pDesc->Exports[i].ClosestHitIndex != SM50_RT_INDEX_NONE;
+  }
+  const uint64_t reflection_count = uint64_t(pDesc->ExportCount) + 1 +
+    uint32_t(has_intersection) + uint32_t(raygen_count > 1) + procedural_continuation_count;
+  if (reflection_count > FunctionCapacity) {
+    reportMessage(
+      "the reflection buffer is smaller than the export count plus compiler callbacks",
+      ppError
+    );
+    return 0;
+  }
+
+  /*
+   * Validate the description before any DXIL is touched. A hit group is one entry
+   * whose *_index fields name its members, so the checks below are what stops a
+   * member from being silently ignored.
+   */
+
+  std::vector<uint32_t> raygen_indices;
+  bool have_raygen = false;
+  for (uint32_t i = 0; i < pDesc->ExportCount; ++i) {
+    const SM50_RT_EXPORT &export_desc = pDesc->Exports[i];
+    if (!export_desc.EntryPoint || !export_desc.EntryPoint[0]) {
+      reportMessage("a raytracing export has no entry point name", ppError);
+      return 0;
+    }
+    /*
+     * The container entry point name is what selects the function inside the DXIL
+     * library; without it the export could only be compiled by guessing, so a
+     * description that omits it is refused rather than lowered from the wrong entry.
+     */
+    if (!export_desc.ContainerEntryPoint || !export_desc.ContainerEntryPoint[0]) {
+      reportMessage(
+        "a raytracing export has no DXIL container entry point name", ppError
+      );
+      return 0;
+    }
+    if (export_desc.LibraryIndex >= pDesc->LibraryCount) {
+      reportMessage("a raytracing export names a library that is not in the description", ppError);
+      return 0;
+    }
+    switch (export_desc.Stage) {
+    case SM50_RT_STAGE_RAYGEN:
+      have_raygen = true;
+      raygen_indices.push_back(i);
+      break;
+    case SM50_RT_STAGE_MISS:
+    case SM50_RT_STAGE_CLOSEST_HIT:
+    case SM50_RT_STAGE_CALLABLE:
+    case SM50_RT_STAGE_ANY_HIT:
+    case SM50_RT_STAGE_INTERSECTION:
+      break;
+    default:
+      reportMessage(
+        "a raytracing export has a stage that is not a raytracing stage; only ray "
+        "generation, miss, any-hit, closest-hit, intersection and callable are supported",
+        ppError
+      );
+      return 0;
+    }
+    /*
+     * A hit group is described by exactly one entry whose *_index fields name its
+     * members. The primary shader of a procedural group is its intersection shader
+     * and of a triangle group its closest-hit shader, which is what the runtime
+     * resolves; a group whose primary stage disagrees with its type cannot be
+     * installed consistently, so it is refused.
+     */
+    if (export_desc.HitGroupType == SM50_RT_HIT_GROUP_PROCEDURAL &&
+        export_desc.Stage != SM50_RT_STAGE_INTERSECTION) {
+      reportMessage(
+        "a procedural hit group must be described by its intersection shader", ppError
+      );
+      return 0;
+    }
+    if (export_desc.HitGroupType == SM50_RT_HIT_GROUP_TRIANGLES &&
+        export_desc.Stage == SM50_RT_STAGE_INTERSECTION) {
+      reportMessage(
+        "a triangle hit group has no intersection shader: it is described by its "
+        "closest-hit shader",
+        ppError
+      );
+      return 0;
+    }
+    if (export_desc.AnyHitIndex != SM50_RT_INDEX_NONE &&
+        export_desc.AnyHitIndex >= pDesc->ExportCount) {
+      reportMessage("a hit group names an any-hit export that does not exist", ppError);
+      return 0;
+    }
+    if (export_desc.ClosestHitIndex != SM50_RT_INDEX_NONE &&
+        export_desc.ClosestHitIndex >= pDesc->ExportCount) {
+      reportMessage("a hit group names a closest-hit export that does not exist", ppError);
+      return 0;
+    }
+    if (export_desc.IntersectionIndex != SM50_RT_INDEX_NONE &&
+        export_desc.IntersectionIndex >= pDesc->ExportCount) {
+      reportMessage("a hit group names an intersection export that does not exist", ppError);
+      return 0;
+    }
+  }
+  if (!have_raygen) {
+    reportMessage("a raytracing pipeline needs one ray generation shader", ppError);
+    return 0;
+  }
+
+  /* One metallib for the whole pipeline: every export becomes its own function
+   * record inside it (MetallibWriter isolates each export's AIR bitcode), so the
+   * runtime loads the library once and creates every function from it. */
+  LLVMContext context;
+  context.setOpaquePointers(false);
+  Module air_module("raytracing.air", context);
+  dxmt::initializeModule(air_module);
+
+  std::vector<SM50_RT_FUNCTION_INFO> functions;
+  functions.reserve(reflection_count);
+  std::vector<std::string> function_names;
+  function_names.reserve(reflection_count);
+  std::vector<uint32_t> continuations(pDesc->ExportCount, SM50_RT_INDEX_NONE);
+  for (uint32_t i = 0; i < pDesc->ExportCount; ++i) {
+    if (pDesc->Exports[i].ClosestHitIndex != SM50_RT_INDEX_NONE)
+      continuations[i] = i;
+  }
+
+  for (uint32_t i = 0; i < pDesc->ExportCount; ++i) {
+    const SM50_RT_EXPORT &group = pDesc->Exports[i];
+    const uint32_t variants = group.Stage == SM50_RT_STAGE_INTERSECTION &&
+      group.ClosestHitIndex != SM50_RT_INDEX_NONE ? 2 : 1;
+    for (uint32_t variant = 0; variant < variants; ++variant) {
+      SM50_RT_EXPORT export_desc = group;
+      if (variant) {
+        const auto &closest_hit = pDesc->Exports[group.ClosestHitIndex];
+        export_desc.Stage = SM50_RT_STAGE_CLOSEST_HIT;
+        export_desc.LibraryIndex = closest_hit.LibraryIndex;
+        export_desc.ContainerEntryPoint = closest_hit.ContainerEntryPoint;
+      }
+      const SM50_RT_LIBRARY &library = pDesc->Libraries[export_desc.LibraryIndex];
+
+      dxil::RaytracingExportContext export_context;
+      export_context.stage = export_desc.Stage;
+      export_context.export_index = i;
+      export_context.local_root_table_slot = SM50_RT_BINDING_INDEX_LOCAL_ROOT_TABLE;
+      export_context.dispatch_arguments_slot = SM50_RT_BINDING_INDEX_DISPATCH;
+      export_context.intersection_function_table_slot =
+        SM50_RT_BINDING_INDEX_INTERSECTION_FUNCTION_TABLE;
+      export_context.visible_function_table_slot = SM50_RT_BINDING_INDEX_VISIBLE_FUNCTION_TABLE;
+      export_context.frame_size = sizeof(SM50_RT_FRAME);
+      export_context.payload_size = pDesc->MaxPayloadSize;
+      export_context.attribute_size = pDesc->MaxAttributeSize;
+      export_context.hit_state_size = (uint32_t)sizeof(SM50_RT_HIT_STATE);
+      /*
+       * The per-candidate region holds the control block *and* one attribute region
+       * (kRtCandidateRegionSize), because the traversal lowering and the callback layer
+       * address the candidate's attributes right after the control block. Publishing
+       * only the control block would make every `dx.op.reportHit` fail its layout check.
+       */
+      export_context.candidate_size = dxil::kRtCandidateRegionSize(pDesc->MaxAttributeSize);
+      /*
+       * The hit-group members this export runs as, taken straight from the export
+       * description. A hit group is one entry whose *_index fields name its members, and
+       * the per-candidate callback layer resolves the group's other members through
+       * these: without them a triangle hit group would accept every candidate
+       * unconditionally (its any-hit shader would never run, because the shared dispatch
+       * callback resolves it from the group's export index) and a procedural hit group
+       * would report hits with no any-hit hook at all.
+       */
+      export_context.closest_hit_index = export_desc.ClosestHitIndex;
+      export_context.any_hit_index = export_desc.AnyHitIndex;
+      export_context.intersection_index = export_desc.IntersectionIndex;
+      export_context.hit_group_continuations = continuations.data();
+      export_context.hit_group_continuation_count = continuations.size();
+      export_context.max_recursion_depth = pDesc->MaxRecursionDepth ? pDesc->MaxRecursionDepth : 1;
+      export_context.pipeline_flags = pDesc->Flags;
+      export_context.global_root_signature = pDesc->GlobalRootSignature;
+      export_context.global_root_signature_size = pDesc->GlobalRootSignatureSize;
+      export_context.local_root_signature = export_desc.LocalRootSignature;
+      export_context.local_root_signature_size = export_desc.LocalRootSignatureSize;
+      export_context.is_dispatch_entry = (raygen_indices.size() == 1 && i == raygen_indices[0]);
+
+      /* The AIR function name is the export name: that is what the runtime looks the
+       * function up by inside the metallib. */
+      const std::string function_name = variant
+        ? std::string(export_desc.EntryPoint) + ".closest_hit" : export_desc.EntryPoint;
+
+      dxil::RootSignatureBlob local = dxil::unwrapRootSignature(
+        export_desc.LocalRootSignature, export_desc.LocalRootSignatureSize
+      );
+      dxil::RootSignatureBlob global =
+        dxil::unwrapRootSignature(pDesc->GlobalRootSignature, pDesc->GlobalRootSignatureSize);
+      const dxil::RootSignatureBlob &rootsig = local.data ? local : global;
+      if (!rootsig.data || !rootsig.size) {
+        reportMessage("a raytracing pipeline needs a global or local root signature", ppError);
+        return 0;
+      }
+
+      auto info = dxil::ModuleInfo::Parse(
+        library.Bytecode, static_cast<size_t>(library.Size), export_desc.ContainerEntryPoint
+      );
+      if (!info) {
+        reportError(info.takeError(), ppError);
+        return 0;
+      }
+
+      /*
+       * The container's `!dx.shaderModel` says "lib" for every entry, so the stage
+       * comes from the export description; D3D12 derived it from the same per-entry
+       * metadata the enumeration reads. A single-stage container keeps its own stage
+       * when it agrees with the description.
+       */
+      dxil::Stage stage = dxil::stageFromShaderKind(export_desc.Stage);
+      if (stage == dxil::Stage::Invalid) {
+        reportMessage("a raytracing export has an unknown stage", ppError);
+        return 0;
+      }
+      if ((*info)->stage != dxil::Stage::Library && (*info)->stage != stage) {
+        reportMessage(
+          "a raytracing export's entry point stage does not match the stage the state "
+          "object assigned it",
+          ppError
+        );
+        return 0;
+      }
+      (*info)->stage = stage;
+
+      /*
+       * Everything below lowers *this* export, and every lowering pass scans every
+       * function definition of the module it is given: the container's other exports
+       * have to be gone first, or an operation that is invalid outside their stage is
+       * reported while this one is compiled (see IsolateSelectedExport).
+       */
+      dxmt::dxil::IsolateSelectedExport(*(*info)->module, *(*info)->entry);
+
+      SM50_SHADER_ROOT_SIGNATURE_DATA rootsig_data{};
+      SM50_SHADER_COMMON_DATA common_data{};
+      rootsig_data.type = SM50_SHADER_ROOT_SIGNATURE;
+      rootsig_data.bytecode = rootsig.data;
+      rootsig_data.bytecode_length = rootsig.size;
+      common_data.type = SM50_SHADER_COMMON;
+      common_data.metal_version = (SM50_SHADER_METAL_VERSION)pDesc->MetalVersion;
+      common_data.flags = (SM50_SHADER_FLAG)0;
+      common_data.next = &rootsig_data;
+
+      dxbc::SM50ShaderInternal shader;
+
+      auto binding = dxil::LowerRaytracingStage(
+        **info, export_context, shader, function_name.c_str(),
+        (SM50_SHADER_COMPILATION_ARGUMENT_DATA *)&common_data
+      );
+      if (!binding) {
+        reportError(binding.takeError(), ppError);
+        return 0;
+      }
+      /*
+       * A RaytracingAccelerationStructure is an ordinary root-signature SRV, so the
+       * operation pass resolves its descriptor - and therefore the structure's D3D12 GPU
+       * virtual address the traversal loads its Metal structure out of - through the same
+       * binding map this export was staged with. Without it every shader that names a
+       * structure fails as unbound. The map outlives the call: the unique_ptr is held
+       * here and LowerResources takes the same object by reference immediately afterwards.
+       */
+      export_context.binding = binding->get();
+
+      if (auto failure = dxil::LowerRaytracingOperations(**info, export_context, function_name)) {
+        reportError(std::move(failure), ppError);
+        return 0;
+      }
+
+      if (auto failure = dxil::LowerResources(**info, **binding)) {
+        reportError(std::move(failure), ppError);
+        return 0;
+      }
+
+      if (auto failure = dxil::LowerOperations(*(*info)->module)) {
+        reportError(std::move(failure), ppError);
+        return 0;
+      }
+
+      if (auto failure = dxil::VerifyLoweredModule(*(*info)->module)) {
+        reportError(std::move(failure), ppError);
+        return 0;
+      }
+      dxil::StripDXILArtifacts(*(*info)->module);
+
+      if (auto failure = dxil::MergeRaytracingExport(air_module, *(*info)->module, function_name)) {
+        reportError(std::move(failure), ppError);
+        return 0;
+      }
+
+      SM50_RT_FUNCTION_INFO function{};
+      function_names.push_back(function_name);
+      function.Name = nullptr; /* filled once the vector stops reallocating */
+      function.ExportName = export_desc.EntryPoint;
+      function.Kind = dxil::functionKindOfStage(export_desc.Stage);
+      function.ExportIndex = i;
+      /* Export bodies have no hardware IFT slot: shared callbacks select them on GPU. */
+      function.TableIndex = SM50_RT_INDEX_NONE;
+      function.IsDispatchEntry = export_context.is_dispatch_entry ? 1u : 0u;
+      functions.push_back(function);
+    }
+  }
+
+  /*
+   * One shared per-candidate dispatch callback for the whole pipeline: it is what runs
+   * every hit group's any-hit shader per candidate (see EmitDispatchCallback). It is
+   * emitted after the exports so the module it is added to already has the entry kinds
+   * the metallib writer looks for, and it is registered in the reflection as a
+   * DISPATCH record the runtime installs in the intersection function table.
+   */
+  {
+    dxil::RaytracingExportContext callback_context;
+    callback_context.dispatch_arguments_slot = SM50_RT_BINDING_INDEX_DISPATCH;
+    callback_context.visible_function_table_slot = SM50_RT_BINDING_INDEX_VISIBLE_FUNCTION_TABLE;
+    callback_context.frame_size = sizeof(SM50_RT_FRAME);
+    callback_context.payload_size = pDesc->MaxPayloadSize;
+    callback_context.attribute_size = pDesc->MaxAttributeSize;
+    callback_context.hit_state_size = (uint32_t)sizeof(SM50_RT_HIT_STATE);
+    callback_context.candidate_size = dxil::kRtCandidateRegionSize(pDesc->MaxAttributeSize);
+
+    if (auto failure = dxmt::dxil::EmitDispatchCallback(
+          air_module, *pDesc, callback_context, "dxmt.rt.candidate"
+        )) {
+      reportError(std::move(failure), ppError);
+      return 0;
+    }
+    /* Geometry kind alone selects the hardware callback slot. */
+    SM50_RT_FUNCTION_INFO function{};
+    function_names.push_back("dxmt.rt.candidate");
+    function.Name = nullptr;
+    function.ExportName = nullptr;
+    function.Kind = SM50_RT_FUNCTION_DISPATCH;
+    function.ExportIndex = SM50_RT_INDEX_NONE;
+    function.TableIndex = 0;
+    function.IsDispatchEntry = 0;
+    functions.push_back(function);
+    if (has_intersection) {
+      if (auto failure = dxmt::dxil::EmitBoundingBoxDispatch(
+            air_module, *pDesc, callback_context, "dxmt.rt.bounding_box")) {
+        reportError(std::move(failure), ppError);
+        return 0;
+      }
+      function_names.push_back("dxmt.rt.bounding_box");
+      function.TableIndex = 1;
+      functions.push_back(function);
+    }
+  }
+
+  if (raygen_indices.size() > 1) {
+
+    std::vector<std::string> raygen_function_names;
+    for (uint32_t idx : raygen_indices)
+      raygen_function_names.push_back(pDesc->Exports[idx].EntryPoint);
+    if (auto failure = EmitRayGenerationDispatch(
+          air_module, raygen_indices, raygen_function_names, "dxmt.rt.raygen_dispatcher"
+        )) {
+      reportError(std::move(failure), ppError);
+      return 0;
+    }
+    SM50_RT_FUNCTION_INFO function{};
+    function_names.push_back("dxmt.rt.raygen_dispatcher");
+    function.Name = nullptr;
+    function.ExportName = nullptr;
+    function.Kind = SM50_RT_FUNCTION_RAYGEN;
+    function.ExportIndex = SM50_RT_INDEX_NONE;
+    function.TableIndex = SM50_RT_INDEX_NONE;
+    function.IsDispatchEntry = 1;
+    functions.push_back(function);
+  }
+
+  /*
+   * The names the reflection points at have to outlive this call, so they move into the
+   * object the caller owns through `sm50_bitcode_t` before the pointers are published.
+   */
+
+  if (llvm::verifyModule(air_module, &llvm::errs())) {
+    llvm::errs() << "OWNED_RT_INVALID_IR_BEGIN\n";
+    air_module.print(llvm::errs(), nullptr);
+    llvm::errs() << "OWNED_RT_INVALID_IR_END\n";
+    reportMessage("invalid merged raytracing AIR module", ppError);
+    return 0;
+  }
+
+  auto compiled = new dxil::SM50CompiledBitcodeInternal();
+  compiled->function_names = std::move(function_names);
+  for (size_t i = 0; i < functions.size(); ++i)
+    functions[i].Name = compiled->function_names[i].c_str();
+
+  /*
+   * The merged module is optimized as a whole, exactly as a raster shader is after its
+   * lowering: `runOptimizationPasses`'s first pass is InferAddressSpacesPass(0), which
+   * folds the address-space casts `PrepareModuleStorage` left on module-scope globals
+   * back onto their new storage space. It has to run before the metallib writer, which
+   * serializes what it is given, and on the merged module so one call covers every
+   * export.
+   */
+
+  dxmt::runOptimizationPasses(air_module);
+
+
+  raw_svector_ostream stream(compiled->vec);
+  metallib::MetallibWriter writer;
+  writer.Write(air_module, stream);
+
+  *ppBitcode = (sm50_bitcode_t)compiled;
+  SM50GetCompiledBitcode(*ppBitcode, pMetallib);
+  for (size_t i = 0; i < functions.size(); ++i)
+    pFunctions[i] = functions[i];
+  *pFunctionCount = static_cast<uint32_t>(functions.size());
+
+  return 1;
+}
diff --git a/src/airconv/dxil_raytracing.h b/src/airconv/dxil_raytracing.h
new file mode 100644
index 0000000000000000000000000000000000000000..b94b5214f22f7e8e86667f22b06c88da5f23ad8a
--- /dev/null
+++ b/src/airconv/dxil_raytracing.h
@@ -0,0 +1,527 @@
+#pragma once
+
+/*
+ * Owned DXIL raytracing pipeline -> AIR/Metal compilation ABI.
+ *
+ * This is the whole-pipeline ("C/POD") contract between the D3D12 runtime side
+ * (state objects, SBT, DispatchRays) and the compiler side. It is deliberately a
+ * single POD description in, a single metallib + reflection out: everything that
+ * the runtime has to agree on about the *shader* ABI lives in this header.
+ *
+ * Not derived from, and not compatible with, any vendor shader-identifier table,
+ * function mask or SBT converter: the runtime keeps D3D12 semantics (32 byte shader
+ * identifiers + verbatim local root data) and this compiler lowers DXIL libraries
+ * and exports onto native public Metal functions.
+ *
+ * Sibling header: dxil_converter.hpp (ModuleInfo/LowerStage/LowerResources/
+ * LowerOperations) owns the generic DXIL front end this file builds on.
+ */
+
+#include "airconv_public.h"
+
+#ifndef __AIRCONV_DXIL_RAYTRACING_H
+#define __AIRCONV_DXIL_RAYTRACING_H
+
+/** Value used in a *_index field to mean "this hit group has no such shader". */
+#define SM50_RT_INDEX_NONE 0xffffffffu
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ------------------------------------------------------------------------- */
+/* Pipeline description                                                      */
+/* ------------------------------------------------------------------------- */
+
+/**
+ * DXIL `ShaderKind`, the value of the `!dx.entryPoints` properties tag 8
+ * (`kDxilShaderKindTag`). These are the on-disk DXIL ABI numbers, identical to
+ * `DXIL::ShaderKind` in DXC's DxilConstants.h; the runtime's OwnedRTStage uses the
+ * same numbering, so an export's stage never has to be translated.
+ */
+enum SM50_RT_STAGE : uint32_t {
+  SM50_RT_STAGE_LIBRARY = 6,
+  SM50_RT_STAGE_RAYGEN = 7,
+  SM50_RT_STAGE_INTERSECTION = 8,
+  SM50_RT_STAGE_ANY_HIT = 9,
+  SM50_RT_STAGE_CLOSEST_HIT = 10,
+  SM50_RT_STAGE_MISS = 11,
+  SM50_RT_STAGE_CALLABLE = 12,
+  SM50_RT_STAGE_MESH = 13,
+  SM50_RT_STAGE_AMPLIFICATION = 14,
+};
+
+/** D3D12_HIT_GROUP_TYPE; only meaningful when Stage == SM50_RT_STAGE_INTERSECTION. */
+enum SM50_RT_HIT_GROUP_TYPE : uint32_t {
+  SM50_RT_HIT_GROUP_TRIANGLES = 0,
+  SM50_RT_HIT_GROUP_PROCEDURAL = 1,
+};
+
+/** D3D12_RAYTRACING_PIPELINE_FLAG. The runtime passes the D3D12 dword verbatim. */
+enum SM50_RT_PIPELINE_FLAG : uint32_t {
+  SM50_RT_PIPELINE_FLAG_NONE = 0x0,
+  /** Skip triangle primitives entirely during traversal. */
+  SM50_RT_PIPELINE_FLAG_SKIP_TRIANGLES = 0x100,
+  /** Skip procedural (bounding box) primitives entirely during traversal. */
+  SM50_RT_PIPELINE_FLAG_SKIP_PROCEDURAL_PRIMITIVES = 0x200,
+};
+
+struct SM50_RT_LIBRARY {
+  /** DXBC container holding a `DXIL` chunk with a shader library. */
+  const void *Bytecode;
+  uint64_t Size;
+};
+
+/**
+ * One compiled export.
+ *
+ * Array order is the *export index* the runtime uses everywhere (identifier
+ * payload, hit group indices, callable indices). The runtime resolves hit group
+ * references to export indices before calling the compiler, so a hit group is
+ * described by exactly one entry whose Stage is the "primary" shader of the group
+ * and whose three *_index fields identify the members:
+ *
+ *   procedural hit group -> Stage = INTERSECTION, IntersectionIndex = self,
+ *                           AnyHitIndex / ClosestHitIndex from the group
+ *   triangle hit group   -> Stage = CLOSEST_HIT, ClosestHitIndex = self,
+ *                           AnyHitIndex from the group, IntersectionIndex = NONE
+ *
+ * Members are emitted as inlined code inside the group function, so the group is
+ * a single Metal function - matching D3D12, where a hit group is the dispatch unit.
+ */
+struct SM50_RT_EXPORT {
+  uint32_t Stage; /* SM50_RT_STAGE */
+  uint32_t LibraryIndex;
+  uint32_t HitGroupType; /* SM50_RT_HIT_GROUP_TYPE */
+  uint32_t ClosestHitIndex;
+  uint32_t AnyHitIndex;
+  uint32_t IntersectionIndex;
+  /**
+   * Public D3D12 export name of this export: what D3D12_EXPORT_DESC::Name, the
+   * hit-group shader imports and ID3D12StateObjectProperties::GetShaderIdentifier
+   * use, and the name the AIR/Metal function is created under. It comes from the
+   * library's RDAT unmangled name, never from the mangled entry point.
+   */
+  const char *EntryPoint;
+  /**
+   * The export's `!dx.entryPoints` operand 1, i.e. the name the container declares
+   * the function as. DXC mangles it (a leading 0x01 marker and the C++ signature),
+   * so it is the only name that can select the entry point inside the container:
+   * this is what the compiler parses the library with. Required; an export whose
+   * library declares no entry point under this name fails compilation.
+   */
+  const char *ContainerEntryPoint;
+  /** Local root signature blob; NULL when the export has none. */
+  const void *LocalRootSignature;
+  uint64_t LocalRootSignatureSize;
+};
+
+struct SM50_RT_PIPELINE_DESC {
+  const struct SM50_RT_LIBRARY *Libraries;
+  uint32_t LibraryCount;
+  const struct SM50_RT_EXPORT *Exports;
+  uint32_t ExportCount;
+  /** Global root signature blob shared by every export. */
+  const void *GlobalRootSignature;
+  uint64_t GlobalRootSignatureSize;
+  /** Maximum TraceRay recursion depth (D3D12_MAX_RAY_RECURSION_DEPTH=31 upper bound). */
+  uint32_t MaxRecursionDepth;
+  /** Maximum user payload size in bytes. */
+  uint32_t MaxPayloadSize;
+  /** Maximum user attribute size in bytes. */
+  uint32_t MaxAttributeSize;
+  uint32_t Flags; /* SM50_RT_PIPELINE_FLAG */
+  /** SM50_SHADER_METAL_VERSION, from SM50_SHADER_COMMON_DATA. */
+  uint32_t MetalVersion;
+};
+
+/* ------------------------------------------------------------------------- */
+/* Compiled shader ABI                                                       */
+/* ------------------------------------------------------------------------- */
+
+/**
+ * Metal buffer indices the lowered RT shaders expect. These are *argument* indices
+ * in the same space as GetArgumentIndex() (ConstantBuffer slot N -> index N), so
+ * they line up with MTL_SM50_SHADER_ARGUMENT.SM50BindingSlot when the runtime
+ * enumerates the RT exports.
+ *
+ * Slots 0..7 are already taken by the existing root/argument-table ABI and the
+ * constant buffer slot mask is 16 bit, so 20..23 are reserved here and can never
+ * alias a user constant buffer.
+ */
+enum SM50_RT_BINDING_INDEX : uint32_t {
+  /** SM50_RT_DISPATCH_ARGUMENTS, constant. */
+  SM50_RT_BINDING_INDEX_DISPATCH = 20,
+  /** intersection_function_table<triangle_data, instancing>. */
+  SM50_RT_BINDING_INDEX_INTERSECTION_FUNCTION_TABLE = 21,
+  /**
+   * Base of the per-record translated local root argument tables (see
+   * SM50_RT_DISPATCH_ARGUMENTS::RayGenerationLocalRootTable). Bound as a constant
+   * address space buffer, exactly like SM50_BINDING_INDEX_ROOT_ARGUMENTS: a
+   * record's entry is selected from it with the record's own position and the
+   * table's stride, and is read through the same qword root argument layout the
+   * global root arguments use.
+   */
+  SM50_RT_BINDING_INDEX_LOCAL_ROOT_TABLE = 22,
+  /**
+   * MTLVisibleFunctionTable holding every lowered RT shader. Bound with
+   * MTLComputeCommandEncoder setVisibleFunctionTable:atBufferIndex: at index 23.
+   * Slot 0 is always the null entry, so the function for export index N lives in
+   * slot N + 1; the traversal reads the export index the runtime published and
+   * calls through this table.
+   */
+  SM50_RT_BINDING_INDEX_VISIBLE_FUNCTION_TABLE = 23,
+};
+
+/*
+ * There is deliberately no acceleration-structure binding slot. A
+ * RaytracingAccelerationStructure is an ordinary root-signature SRV, so the shader
+ * resolves the descriptor itself and the traversal takes the structure it named as
+ * its own operand: the descriptor holds the D3D12 GPU virtual address, whose first
+ * qword is the Metal resource id the runtime's build published. Binding one
+ * pipeline-wide structure at a fixed buffer index could only trace the wrong scene
+ * when a shader names several (or names them dynamically).
+ */
+
+/**
+ * Dispatch-time constants, read by every lowered RT stage.
+ *
+ * Bound as a constant buffer at SM50_RT_BINDING_INDEX_DISPATCH. All GPU addresses
+ * are D3D12 device VAs, unmodified from the application's view: the runtime does
+ * not rewrite SBT records.
+ *
+ * Layout is explicit and 8 byte aligned; the compiler emits plain GEPs against it.
+ */
+struct SM50_RT_DISPATCH_ARGUMENTS {
+  /** +0x00 RayGenerationShaderRecord.StartAddress, including the 32 byte identifier. */
+  uint64_t RayGenerationRecord;
+  /** +0x08 MissShaderTable.StartAddress. */
+  uint64_t MissRecordBase;
+  /** +0x10 HitGroupTable.StartAddress. */
+  uint64_t HitGroupRecordBase;
+  /** +0x18 CallableShaderTable.StartAddress. */
+  uint64_t CallableRecordBase;
+  /**
+   * +0x20 Array of `uint32_t` export indices, one per SBT record, laid out
+   * raygen, miss, hit group, callable in that order with the matching strides
+   * below. The runtime builds it from the identifiers it handed out, which is what
+   * turns D3D12's opaque 32 byte identifier back into a compile-time function
+   * index. Element size is always 4 bytes, so the array is contiguous at
+   * `HitGroupRecordIndexBase + record_index` etc.
+   */
+  uint64_t RayGenerationIndexBase;
+  uint64_t MissRecordIndexBase;
+  uint64_t HitGroupRecordIndexBase;
+  uint64_t CallableRecordIndexBase;
+  /** +0x40 Local root argument table for the raygen record (see below). */
+  uint64_t RayGenerationLocalRootTable;
+  uint64_t MissRecordLocalRootTableBase;
+  uint64_t HitGroupRecordLocalRootTableBase;
+  uint64_t CallableRecordLocalRootTableBase;
+  /** +0x60 D3D12_RAYTRACING_SHADER_TABLE strides, all 4 byte multiples. */
+  uint32_t RayGenerationLocalRootTableSize;
+  uint32_t MissRecordStride;
+  uint32_t MissRecordCount;
+  uint32_t HitGroupRecordStride;
+  uint32_t HitGroupRecordCount;
+  uint32_t CallableRecordStride;
+  uint32_t CallableRecordCount;
+  uint32_t MissRecordLocalRootTableStride;
+  uint32_t HitGroupRecordLocalRootTableStride;
+  uint32_t CallableRecordLocalRootTableStride;
+  /** +0x88 SM50_RT_EXPORT count, for bounds checks in CallShader. */
+  uint32_t ExportCount;
+  /** Max recursion depth from the pipeline description. */
+  uint32_t RecursionDepth;
+  /** User payload size in bytes (SM50_RT_PIPELINE_DESC::MaxPayloadSize). */
+  uint32_t PayloadSize;
+  /** User attribute size in bytes (SM50_RT_PIPELINE_DESC::MaxAttributeSize). */
+  uint32_t AttributeSize;
+  /** D3D12_DISPATCH_RAYS_DESC Width/Height/Depth. */
+  uint32_t DispatchWidth;
+  uint32_t DispatchHeight;
+  uint32_t DispatchDepth;
+  /**
+   * The buffer's own D3D12 GPU virtual address: where this struct lives.
+   *
+   * A shader that receives this block as a bound argument (the ray generation
+   * shader, the intersection shader, the shared candidate callback) does not need
+   * it, but a visible function does: it has no bound arguments at all, and the
+   * record index tables, the local root entry bases and the recursion limit all
+   * live here, so the address is what lets the shader that issues a trace hand its
+   * callee the constants to resolve that callee's own record - and what a nested
+   * trace reads the tables through. 0 when nothing filled it.
+   */
+  uint64_t DispatchArgumentsAddress;
+  /** Value of D3D12_RAYTRACING_INSTANCE_DESC flags that matter for opacity culling. */
+  uint32_t Reserve;
+};
+
+/**
+ * Per-invocation frame. Lives inline at the head of the payload/attribute block
+ * that the compiler builds, so the hardware traversal carries it across TraceRay
+ * without any side allocation and without stealing bytes from the user payload.
+ *
+ * The last six fields are the invocation's *runtime context*: the state a shader
+ * needs to resolve its resources and to issue a trace, but cannot derive from its
+ * own arguments.
+ *
+ * Two things force it through here. A shader record's local root arguments are
+ * selected by the party that picks the record, and only that party knows which
+ * record it picked - a visible function receives its *export* index (which is also
+ * its visible function table slot), never the record's position inside its shader
+ * table, so the entry the runtime materialized for that record is computed by the
+ * caller and handed over as SM50_RT_FRAME::LocalRootEntry. And a visible function
+ * is reached through the visible function table with a fixed argument list - the
+ * payload, the hit state, the record and the depth (see EmitVisibleFunctionCall) -
+ * so a miss / closest-hit / any-hit / callable export cannot also be handed the
+ * dispatch constants, the two tables or the root arguments as bound arguments:
+ * they travel in this frame instead, which the caller writes into the block it
+ * allocates for the invocation before calling it.
+ *
+ * Every pointer field is a D3D12 GPU virtual address, read back with an ordinary
+ * device load (the same convention dxil_rt_operations.cpp uses for the structure
+ * header and the record index tables). They are 0 when nothing published them,
+ * which every reader treats as "not bound", never as "use the global root
+ * arguments" or any other substitute.
+ */
+struct SM50_RT_FRAME {
+  /** Export index of the shader currently running (visible function slot - 1). */
+  uint32_t RecordIndex;
+  /** Linear dispatch index: DispatchRaysIndex().x + y * DispatchWidth. */
+  uint32_t LinearIndex;
+  /** Current recursion depth, 0 in the raygen. */
+  uint32_t Depth;
+  uint32_t Flags;
+  /**
+   * The local root entry the runtime materialized for the record this invocation
+   * runs as, i.e. the base of its translated local root arguments - what a D3D12
+   * shader reads as its local root signature's arguments.
+   *
+   * The caller computes it as
+   *   table base + record position * table stride
+   * out of the four per-table bases and strides of SM50_RT_DISPATCH_ARGUMENTS: the
+   * record position is the miss index for a miss shader, the callable index for a
+   * callable, the hit group index
+   * (`InstanceContributionToHitGroupIndex + RayContributionToHitGroupIndex +
+   * GeometryIndex * MultiplierForGeometryContributionToHitGroupIndex`) for a hit
+   * group, and 0 for the ray generation shader, which is the single record of its
+   * own table. 0 means "no local root arguments", which is what a shader whose
+   * local root signature the runtime has not translated reads - never the global
+   * root arguments.
+   */
+  uint64_t LocalRootEntry;
+  /**
+   * D3D12 GPU virtual address of SM50_RT_DISPATCH_ARGUMENTS, as the shader that
+   * issued the active trace knows it: the address of the buffer the runtime binds at
+   * SM50_RT_BINDING_INDEX_DISPATCH (the runtime publishes it in the block itself,
+   * see SM50_RT_DISPATCH_ARGUMENTS::DispatchArgumentsAddress).
+   *
+   * A ray generation or intersection shader has that buffer as an argument, but a
+   * visible function has no bound arguments at all, and it needs the dispatch
+   * constants to turn the record of a trace it issues into an export index and into
+   * a local root entry (the four tables' bases and strides live there). The address
+   * is therefore published alongside the record.
+   */
+  uint64_t DispatchArguments;
+  /**
+   * D3D12 GPU virtual address of the per-instance contribution array of the
+   * acceleration structure the active trace is tracing: the second qword of that
+   * structure's header, which the runtime's acceleration-structure prepass fills
+   * with the application's `InstanceContributionToHitGroupIndex` words. 0 when the
+   * trace has no such array, i.e. when the structure contributes nothing.
+   *
+   * D3D12's hit group index includes the instance contribution and Metal has no
+   * per-instance field for it, so this is where the tracing shader, the shared
+   * candidate callback and a procedural intersection shader read it.
+   */
+  uint64_t ContributionArray;
+  /**
+   * The pipeline's two function tables, as the ray generation shader received them
+   * (its own arguments, so their GPU addresses are simply the pointer values).
+   *
+   * A visible function cannot declare them: they are arguments of the ray
+   * generation / intersection function, and a call through the visible function
+   * table has a fixed argument list. They are published here so a miss /
+   * closest-hit / any-hit / callable export can issue its own TraceRay (the
+   * intersection function table operand of the traversal) and reach a
+   * miss / hit-group / callable record (the visible function table operand).
+   */
+  uint64_t IntersectionFunctionTable;
+  uint64_t VisibleFunctionTable;
+  /**
+   * The global root arguments and static samplers the runtime bound for this
+   * dispatch (SM50_BINDING_INDEX_ROOT_ARGUMENTS / _STATIC_SAMPLERS), as the ray
+   * generation shader received them.
+   *
+   * Every root signature of a dispatch shares one global root signature, so its
+   * arguments are the same for every stage of the pipeline; a visible function
+   * cannot declare them as arguments, so it reads them through these addresses -
+   * which is what lets a hit / miss / callable shader resolve the resources the
+   * *global* root signature binds (a UAV it writes, a constant buffer it reads, the
+   * acceleration structure it traces) without a second binding ABI.
+   */
+  uint64_t GlobalRootArguments;
+  uint64_t StaticSamplers;
+};
+
+#ifdef __cplusplus
+static_assert(
+  sizeof(SM50_RT_FRAME) == 72, "SM50_RT_FRAME layout is part of the shader ABI"
+);
+#endif
+
+/**
+ * The hit state a hit shader reads its system values from.
+ *
+ * The traversal result carries the primitive / instance / geometry / distance /
+ * barycentrics, and the ray generation shader publishes them here together with the
+ * ray parameters it knows, so a closest-hit or any-hit shader can read exactly the
+ * D3D12 hit system values. It is written by the lowered raygen and passed to the
+ * hit function as its second argument (see the visible-function ABI in
+ * dxil_rt_operations.cpp).
+ *
+ * Both the compiler and the runtime ABI header use this layout; it is POD and 16
+ * byte aligned.
+ */
+struct SM50_RT_HIT_STATE {
+  /** WorldRayOrigin / WorldRayDirection, padded to 4 components. */
+  float WorldRayOrigin[4];
+  float WorldRayDirection[4];
+  /** RayTMin and RayTCurrent. */
+  float RayTMin;
+  float RayTCurrent;
+  /** PrimitiveIndex, InstanceID, InstanceIndex and GeometryIndex. */
+  uint32_t PrimitiveIndex;
+  uint32_t InstanceID;
+  uint32_t InstanceIndex;
+  uint32_t GeometryIndex;
+  /** HitKind and RayFlags. */
+  uint32_t HitKind;
+  uint32_t RayFlags;
+  /** BuiltInTriangleIntersectionAttributes barycentrics and the front-face flag. */
+  float Barycentrics[2];
+  uint32_t FrontFace;
+};
+
+#ifdef __cplusplus
+static_assert(
+  sizeof(SM50_RT_HIT_STATE) == 76, "SM50_RT_HIT_STATE layout is part of the shader ABI"
+);
+#endif
+
+/* ------------------------------------------------------------------------- */
+/* Reflection                                                                */
+/* ------------------------------------------------------------------------- */
+
+enum SM50_RT_FUNCTION_KIND : uint32_t {
+  /** The raygen: `[[kernel]]`, launched as the dispatch's compute function. */
+  SM50_RT_FUNCTION_RAYGEN = 0,
+  /** Intersection export inlined into the GPU-selected bounding-box dispatcher. */
+  SM50_RT_FUNCTION_INTERSECTION = 1,
+  /** `[[visible]]`; installed at ExportIndex + 1 in the visible function table. */
+  SM50_RT_FUNCTION_VISIBLE = 2,
+  /**
+   * Hardware callback selected by geometry kind. Slot 0 handles triangles and
+   * slot 1 bounding boxes. Both select the candidate's hit group from GPU SBT
+   * contents; no CPU shader-record snapshot is involved.
+   */
+  SM50_RT_FUNCTION_DISPATCH = 3,
+};
+
+struct SM50_RT_FUNCTION_INFO {
+  /** Metal function name, as stored in the metallib. */
+  const char *Name;
+  /** Matching SM50_RT_EXPORT::EntryPoint (the public export name). */
+  const char *ExportName;
+  uint32_t Kind; /* SM50_RT_FUNCTION_KIND */
+  /**
+   * Export index this function belongs to, or SM50_RT_INDEX_NONE when it is not an
+   * export (the shared dispatch callback). A DISPATCH record is skipped by the
+   * runtime's export bookkeeping and by the visible function table.
+   */
+  uint32_t ExportIndex;
+  /**
+   * Intersection function table slot this function must be installed at, or
+   * SM50_RT_INDEX_NONE (never installed).
+   *
+   * Only DISPATCH records have slots: 0 for triangles, 1 for bounding boxes.
+   * Original INTERSECTION exports are internal and never installed separately.
+   */
+  uint32_t TableIndex;
+  /** Set on the single raygen; the compute function the runtime must select. */
+  uint32_t IsDispatchEntry;
+};
+
+/* ------------------------------------------------------------------------- */
+/* Entry points                                                              */
+/* ------------------------------------------------------------------------- */
+
+/** One export discovered inside a DXIL library container. */
+struct sm50_rt_library_export_info {
+  /** SM50_RT_STAGE of the export. */
+  uint32_t stage;
+  /**
+   * Offset and length of the UTF-8 public D3D12 export name inside the caller's
+   * pNames buffer. This is the library's RDAT unmangled name for the entry point -
+   * the name D3D12_EXPORT_DESC and the hit-group shader imports refer to.
+   */
+  uint32_t name_offset;
+  uint32_t name_length;
+  /**
+   * Offset and length of the DXIL container entry point name (the library's
+   * `!dx.entryPoints` operand 1, DXC-mangled) in the same pNames buffer. The
+   * runtime needs both spellings: the public one is what the application names,
+   * the container one is what the export must be compiled from.
+   */
+  uint32_t entry_point_offset;
+  uint32_t entry_point_length;
+};
+
+/**
+ * Enumerate the shader exports of a DXIL library container, in container order,
+ * so the runtime can honour D3D12_DXIL_LIBRARY_DESC with NumExports == 0 and
+ * validate ExportToRename without any DXIL knowledge of its own.
+ *
+ * Each export reports two names, both written into pNames: the public D3D12 export
+ * name (the container's RDAT unmangled name, which is what D3D12_EXPORT_DESC and the
+ * hit-group shader imports name) and the container's own entry point name
+ * (`!dx.entryPoints` operand 1, which DXC mangles and which is therefore the only
+ * name that selects the entry point inside the container). A container compiled
+ * without reflection reports its entry point name as both, because that is then the
+ * export's exact identity; nothing is derived from the mangled spelling.
+ *
+ * Two-call protocol: query with pExports == NULL (NameCapacity 0) to learn
+ * *pExportCount and *pNamesSize, then call again with sized buffers. On success
+ * returns 1 and sets both counts; on failure returns 0 and sets *ppError.
+ */
+AIRCONV_API int SM50RTEnumerateLibraryExports(
+  const void *pBytecode, uint64_t BytecodeSize, struct sm50_rt_library_export_info *pExports,
+  uint32_t ExportCapacity, char *pNames, uint64_t NamesSize, uint32_t *pExportCount,
+  uint64_t *pNamesSize, sm50_error_t *ppError
+);
+
+/**
+ * Compile a whole raytracing pipeline.
+ *
+ * On success returns 1 and writes the AIR bitcode handle (owned by the caller,
+ * destroyed with SM50DestroyBitcode) and the serialized metallib. `pFunctions`
+ * receives the reflection in the order the runtime must install them; `pFunctions`
+ * must hold `FunctionCapacity` records, and `FunctionCapacity` must cover the export
+ * count, procedural closest-hit variants, geometry callbacks, and the optional
+ * multi-raygen dispatcher, or the call is refused. On failure
+ * returns 0 and sets *ppError - the two entry points of this header share the
+ * convention, so `!SM50CompileRaytracingPipeline(...)` is the failure test.
+ * Unsupported DXIL in an export is an error, never a silently dropped shader.
+ */
+AIRCONV_API int SM50CompileRaytracingPipeline(
+  const struct SM50_RT_PIPELINE_DESC *pDesc, sm50_bitcode_t *ppBitcode,
+  struct SM50_COMPILED_BITCODE *pMetallib, struct SM50_RT_FUNCTION_INFO *pFunctions,
+  uint32_t FunctionCapacity, uint32_t *pFunctionCount, sm50_error_t *ppError
+);
+
+#ifdef __cplusplus
+};
+#endif
+
+#endif /* __AIRCONV_DXIL_RAYTRACING_H */
