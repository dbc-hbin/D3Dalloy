+  llvm::Expected<dxbc::TextureDescirptor> textureDescriptor(const ResourceHandle &handle, const char *who);
+  llvm::Expected<dxbc::BufferDescriptor> bufferDescriptor(const ResourceHandle &handle, const char *who);
